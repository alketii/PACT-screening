# Copy to .env.local (and set the same variables at your host). Never commit real values.

# Postgres connection string. For Neon: use the *pooled* connection string of an EU region project.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Password for /admin. Use a long random one.
ADMIN_PASSWORD=change-me

# Optional: public address if you use your own domain (Vercel's address is detected automatically).
# NEXT_PUBLIC_SITE_URL=https://example.com
